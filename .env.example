# ---------------------------------------------------------------------------
# Arihant MIS — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection.
# Docker Compose (production) sets this from the values below.
DATABASE_URL="postgresql://arihant:CHANGE_ME@localhost:5432/arihant_mis"

# Used by docker-compose.yml to provision the database container.
POSTGRES_USER=arihant
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=arihant_mis

# Secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Public origin the app is served from. Used for secure-cookie decisions.
APP_URL=http://localhost:3000

# Where uploaded source files are stored on disk.
UPLOAD_DIR=./uploads

# How long to keep uploaded source files, in days. Parsed rows and all MIS
# figures are kept indefinitely; this only prunes the original files.
UPLOAD_RETENTION_DAYS=180

# Where `scripts/backup.sh` writes dumps.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# --- Tally ------------------------------------------------------------------
# These are server-side only and are never sent to the browser.
# Leave TALLY_ENABLED=false until connectivity has been confirmed against
# Arihant's actual Tally installation. See docs/tally-integration.md.
TALLY_ENABLED=false
TALLY_ADAPTER=TALLY_XML_HTTP
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_USE_HTTPS=false
TALLY_COMPANY_NAME=
TALLY_TIMEOUT_MS=60000

# Scheduled sync. Off by default; sync manually from Admin -> Connection.
TALLY_SYNC_ENABLED=false
TALLY_SYNC_CRON="0 * * * *"

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
